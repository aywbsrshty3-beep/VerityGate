            "enabled": true
        }
    },
    "policies": {
        "WCP-1": {
            "id": "WCP-1",
            "name": "Wish Creation Policy",
            "orgId": "CUT-ORG-1",
            "subOrgApplicability": false,
            "wishKind": "WISH_CREATION",
            "ruleIds": [
                "WPR-1"
            ],
            "controls": {},
            "enabled": true,
            "dynamic": false,
            "validFor": 1.7976931348623157e+308
        },
        "TFTO-CUST-POL-1": {
            "id": "TFTO-CUST-POL-1",
            "name": "Transfer Out Customer Policy",
            "orgId": "CUT-ORG-1",
            "subOrgApplicability": false,
            "wishKind": "TRANSFER_OUT",
            "ruleIds": [
                "CUST-RULE-1"
            ],
            "controls": {
                "CUST-RULE-1": "CUST-POL-CTRL"
            },
            "enabled": true,
            "dynamic": false,
            "validFor": 1.7976931348623157e+308
        }
    },
    "rules": {
        "WPR-1": {
            "id": "WPR-1",
            "name": "Wish Creation Rule",
            "enabled": true,
            "expression": "\n    ((ctx.actors[ctx.wish.actorId].orgId === ctx.wish.tgtOrgId && ctx.actors[ctx.wish.actorId].role === \"MAKER\") ||\n    (ctx.orgs[ctx.actors[ctx.wish.actorId].orgId].id === \"EXC-ORG-1\" && ctx.wallets[ctx.wish.payload.fromWallet].meta[\"TYPE\"] === \"SETTLEMENT\"))\n    "
        },
        "CUST-RULE-1": {
            "id": "CUST-RULE-1",
            "name": "Transfer Out Rule",
            "expression": "\n    (ctx.actors[ctx.wish.actorId].orgId === \"EXC-ORG-1\" || ctx.actors[ctx.wish.actorId].orgId === \"CUT-ORG-1\") && \n    ctx.actors[ctx.wish.actorId].role === \"MAKER\" &&\n    ctx.wallets[ctx.wish.payload.fromWallet].orgId === ctx.wish.tgtOrgId && \n    ctx.wallets[ctx.wish.payload.fromWallet].meta[\"TYPE\"] === \"SETTLEMENT\"\n  ",
            "enabled": true
        }
    },
    "controls": {
        "CUST-POL-CTRL": {
            "id": "CUST-POL-CTRL",
            "name": "CUST-POLICY-CTRL",
            "config": {
                "roles": [
                    "CHECKER",
                    "CHECKER"
                ],
                "orgs": [
                    "CUT-ORG-1",
                    "EXC-ORG-1"
                ],
                "minApprover": 2,
                "timeoutInSeconds": 3600
            }
        }
    },
    "wallets": {
        "MyBTCWallet": {
            "id": "MyBTCWallet",
            "name": "BTC Trading Wallet",
            "orgId": "CUT-ORG-1",
            "chain": "TESTNET",
            "meta": {
                "TYPE": "SETTLEMENT"
            }
        }
    },
    "wish": {
        "id": "WISH-2",
        "actorId": "E-M-1",
        "tgtOrgId": "CUT-ORG-1",
        "kind": "TRANSFER_OUT",
        "payload": {
            "fromWallet": "MyBTCWallet",
            "toAddress": "0x546",
            "amount": "8000"
        }
    }
